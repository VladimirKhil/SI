<UserControl
    x:Class="SIQuester.NewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SIQuester"
    xmlns:lb="clr-namespace:SIQuester.Behaviors"
    xmlns:m="clr-namespace:SIQuester.Model;assembly=SIQuester.ViewModel"
    xmlns:lvm="clr-namespace:SIQuester.ViewModel;assembly=SIQuester.ViewModel"
    xmlns:lp="clr-namespace:SIQuester.Properties"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance lvm:NewViewModel}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    FontSize="14"
    FocusManager.FocusedElement="{Binding ElementName=bCreate}"
    Background="{Binding Theme, Source={x:Static m:AppSettings.Default}, Converter={StaticResource ThemeBackgroundConverter}, FallbackValue=#FFFBFBFF, TargetNullValue=#FFFBFBFF}"
    Foreground="{DynamicResource Ui.Text}">
    <UserControl.Resources>
        <!-- Section card (same look as the Settings page) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,14,20,18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource Ui.Accent}" />
            <Setter Property="Padding" Value="28,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Ui.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template tile: name + description; hover and selection like the rest of the app -->
        <Style x:Key="TemplateItem" TargetType="ListViewItem">
            <EventSetter Event="MouseDoubleClick" Handler="ListView_DoubleClick" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="Bd"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Ui.CardStroke}"
                            Background="Transparent"
                            Padding="14,9">
                            <DockPanel>
                                <Border
                                    x:Name="Mark"
                                    DockPanel.Dock="Left"
                                    Width="3"
                                    CornerRadius="1.5"
                                    Margin="0,2,12,2"
                                    Background="{DynamicResource Ui.Accent}"
                                    Opacity="0" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type m:CustomPackageOptions}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Header}" Text="{x:Static lp:Resources.NonStandardPackageParameters}" />

                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,6" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style TargetType="l:NumericTextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Width" Value="120" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static lp:Resources.RoundCount}" />
                        <l:NumericTextBox Grid.Column="1" Text="{Binding RoundCount}" />
                        <TextBlock Grid.Row="1" Text="{x:Static lp:Resources.RoundThemeCount}" />
                        <l:NumericTextBox Grid.Row="1" Grid.Column="1" Text="{Binding ThemeCount}" />
                        <TextBlock Grid.Row="2" Text="{x:Static lp:Resources.ThemeQuestionCount}" />
                        <l:NumericTextBox Grid.Row="2" Grid.Column="1" Text="{Binding QuestionCount}" />
                        <TextBlock Grid.Row="3" Text="{x:Static lp:Resources.BaseQuestionPrice}" />
                        <l:NumericTextBox Grid.Row="3" Grid.Column="1" Text="{Binding BaseQuestionPrice}" />
                        <TextBlock Grid.Row="4" Text="{x:Static lp:Resources.FinalRound}" />
                        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding HasFinal}" />
                        <TextBlock Grid.Row="5" Text="{x:Static lp:Resources.FinalThemeCount}" />
                        <l:NumericTextBox Grid.Row="5" Grid.Column="1" Text="{Binding FinalThemeCount}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="NonStandartArea" TargetType="ContentControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentTemplate.Type}" Value="{x:Static m:PackageType.Custom}">
                    <Setter Property="Content" Value="{Binding CustomPackageOptions}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- Centered column of rounded cards, like the Settings page -->
        <StackPanel Margin="24,20,24,24" MaxWidth="720" MinWidth="460" HorizontalAlignment="Center">
            <TextBlock
                Text="{x:Static lp:Resources.StartNew}"
                FontSize="24"
                FontWeight="SemiBold"
                Margin="2,0,0,14" />

            <!-- Template -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            VerticalAlignment="Top"
                            Padding="12,3"
                            Content="{x:Static lp:Resources.RemoveTemplate}"
                            Command="{Binding RemoveTemplate}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTemplate.FileName}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Style="{StaticResource Header}" Text="{x:Static lp:Resources.PackageType}" />
                    </DockPanel>

                    <ListView
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Templates}"
                        SelectedItem="{Binding CurrentTemplate}"
                        ItemContainerStyle="{StaticResource TemplateItem}">
                        <ListView.Template>
                            <ControlTemplate TargetType="ListView">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListView.Template>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}" />
                                    <TextBlock
                                        Text="{Binding Description}"
                                        Margin="0,2,0,0"
                                        FontSize="13"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource Ui.Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Package -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Header}" Text="{x:Static lp:Resources.Package}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static lp:Resources.PackageName}" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding PackageName}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static lp:Resources.PackageAuthor}" />
                            <TextBox Style="{StaticResource Field}" Text="{Binding PackageAuthor}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox
                            IsChecked="{Binding QualityControl}"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Foreground="{DynamicResource Ui.Text}"
                            Content="{x:Static lp:Resources.QualityControl}" />

                        <TextBlock
                            x:Name="QualityWarning"
                            ToolTip="{x:Static lp:Resources.QualityControlWarning}"
                            Text="⚠️"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Foreground="OrangeRed"
                            Visibility="{Binding QualityControl, Converter={StaticResource FalseToVisiblityConverter}}" />
                    </StackPanel>

                    <TextBlock
                        Text="{x:Static lp:Resources.QualityControlHint}"
                        Margin="30,4,0,0"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource Ui.Muted}" />
                </StackPanel>
            </Border>

            <!-- Non-standard package options (only for the custom template) -->
            <ContentControl Style="{StaticResource NonStandartArea}" Focusable="False" />

            <Button
                Name="bCreate"
                HorizontalAlignment="Right"
                Margin="0,4,0,0"
                Style="{StaticResource AccentButton}"
                Command="{Binding Create}"
                Content="{x:Static lp:Resources.Create}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
