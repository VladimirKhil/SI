<UserControl
    x:Class="SIQuester.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvm="clr-namespace:SIQuester.ViewModel;assembly=SIQuester.ViewModel"
    xmlns:lp="clr-namespace:SIQuester.Properties"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="300"
    d:DataContext="{d:DesignInstance lvm:StatisticsViewModel}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    TextElement.Foreground="{DynamicResource Ui.Text}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Summary tile: big number + caption -->
        <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
        </Style>

        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}" />
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Flat button with an icon (Refresh / Remove unused files) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,6" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Ui.CardStroke}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6" Background="Transparent">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource Ui.Accent}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8,4,8,8">
            <!-- Summary -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileNumber}" Text="{Binding RoundCount}" />
                        <TextBlock Style="{StaticResource TileCaption}" Text="{x:Static lp:Resources.StatisticsRounds}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileNumber}" Text="{Binding ThemeCount}" />
                        <TextBlock Style="{StaticResource TileCaption}" Text="{x:Static lp:Resources.StatisticsThemes}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TileNumber}" Text="{Binding QuestionCount}" />
                        <TextBlock Style="{StaticResource TileCaption}" Text="{x:Static lp:Resources.Questions}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What to check -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static lp:Resources.StatsChecks}" />

                    <CheckBox IsChecked="{Binding CheckEmptyAuthors}">
                        <TextBlock Text="{x:Static lp:Resources.AuthorsAbsence}" TextWrapping="Wrap" />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CheckEmptySources}">
                        <TextBlock Text="{x:Static lp:Resources.SourcesAbsense}" TextWrapping="Wrap" />
                    </CheckBox>

                    <CheckBox IsChecked="{Binding CheckBrackets}">
                        <TextBlock Text="{x:Static lp:Resources.OpenCloseBracketsIncosistency}" TextWrapping="Wrap" />
                    </CheckBox>

                    <Button Style="{StaticResource ActionButton}" Command="{Binding Create}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static lp:Resources.Refresh}" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ActionButton}" Command="{Binding RemoveUnusedFiles}" Margin="0,6,0,0" ToolTip="{x:Static lp:Resources.StatsRemoveUnusedHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0" Foreground="#FFD13438" />
                            <TextBlock Text="{x:Static lp:Resources.RemoveUnusedFiles}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Warnings -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static lp:Resources.StatsWarnings}" />

                    <!-- Nothing to fix -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoWarnings}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="13" Foreground="#FF2E9E44" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static lp:Resources.StatisticsNoWarnings}" FontSize="13" Foreground="{DynamicResource Ui.Muted}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,6" Background="#1FF7A400">
                                    <DockPanel>
                                        <Button
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource GoButton}"
                                            Command="{Binding NavigateToSource}"
                                            ToolTip="{x:Static lp:Resources.Goto}" />

                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="13" Foreground="#FFE08A00" VerticalAlignment="Top" Margin="0,2,8,0" />

                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Per-round details -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static lp:Resources.StatsDetails}" />

                    <TextBox
                        Text="{Binding Details, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        BorderThickness="0"
                        Background="Transparent"
                        Padding="0"
                        FontSize="13"
                        Foreground="{DynamicResource Ui.Text}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
