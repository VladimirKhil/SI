<metro:MetroWindow
    x:Class="SIQuester.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:siq="clr-namespace:SIQuester"
    xmlns:siqcv="clr-namespace:SIQuester.Converters"
    xmlns:m="clr-namespace:SIQuester.Model;assembly=SIQuester.ViewModel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SIQuester.ViewModel;assembly=SIQuester.ViewModel"
    xmlns:st="clr-namespace:System.Threading;assembly=mscorlib"
    xmlns:metro="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lp="clr-namespace:SIQuester.Properties"
    mc:Ignorable="d" 
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="SIQuester"
    Height="450"
    Width="746"
    TitleCharacterCasing="Normal"
    TitleBarHeight="32"
    WindowTitleBrush="{DynamicResource Ui.TitleBar}"
    NonActiveWindowTitleBrush="{DynamicResource Ui.TitleBarInactive}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Name="main"
    WindowState="Maximized"
    Icon="Resources/logo.jpg"
    Closing="Main_Closing"
    Loaded="Main_Loaded"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    PreviewKeyDown="Main_PreviewKeyDown"
    PreviewMouseWheel="Main_PreviewMouseWheel"
    Background="{Binding Theme, Source={x:Static m:AppSettings.Default}, Converter={StaticResource ThemeBackgroundConverter}, FallbackValue=#FFFBFBFF, TargetNullValue=#FFFBFBFF}"
    Foreground="{Binding Theme, Source={x:Static m:AppSettings.Default}, Converter={StaticResource ThemeForegroundConverter}, FallbackValue=Black, TargetNullValue=Black}">
    <Window.Resources>
        <siqcv:UnionConverter x:Key="UnionConverter" />
        <siqcv:DirectoryConverter x:Key="DirectoryConverter" />
        <siqcv:FileNameConverter x:Key="FileNameConverter" />

        <!-- Title bar buttons: white Fluent glyphs with a soft rounded hover (like Office) -->
        <Style x:Key="TitleBarButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" CornerRadius="5" Background="Transparent">
                            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <DataTemplate x:Key="TabItemHeaderTemplate">
            <DockPanel AllowDrop="True" Height="25" Background="Transparent">
                <Button
                    Name="cb"
                    Visibility="Hidden"
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Margin="5,0,2,0"
                    Padding="0"
                    Width="20"
                    Height="20"
                    Command="{Binding Close}"
                    ToolTip="{x:Static lp:Resources.Close}"
                    FocusVisualStyle="{x:Null}">
                    <!-- Round close button, readable in light and dark themes -->
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent">
                                <TextBlock
                                    x:Name="Glyph"
                                    Text="&#xE711;"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="10"
                                    Foreground="{DynamicResource Ui.Muted}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Ui.Hover}" />
                                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Ui.Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ContentControl Style="{StaticResource WarningBox}" />

                <TextBlock
                    MinWidth="80"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding Header}"
                    ToolTip="{Binding ToolTip}"
                    Margin="2,0,0,0" />
            </DockPanel>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="cb" Property="Visibility" Value="Visible" />
                </Trigger>

                <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter TargetName="cb" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TabControlStyle1" TargetType="{x:Type TabControl}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Background" Value="{StaticResource MainBack}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.CardStroke}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid x:Name="templateRoot" ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColumnDefinition0"/>
                                <ColumnDefinition x:Name="ColumnDefinition1" Width="0"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RowDefinition0" Height="Auto"/>
                                <RowDefinition x:Name="RowDefinition1" Height="*"/>
                            </Grid.RowDefinitions>

                            <TabPanel
                                x:Name="HeaderPanel"
                                Background="Transparent"
                                Grid.Column="0"
                                IsItemsHost="True"
                                Margin="0"
                                Grid.Row="0"
                                KeyboardNavigation.TabIndex="1"
                                Panel.ZIndex="1" />

                            <Border
                                x:Name="ContentPanel"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Grid.Row="1"
                                Grid.Column="0"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2"
                                KeyboardNavigation.TabNavigation="Local">

                                <ContentPresenter
                                    x:Name="PART_SelectedContentHost"
                                    ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                    Content="{TemplateBinding SelectedContent}"
                                    ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                    ContentSource="SelectedContent"
                                    Margin="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="TabStripPlacement" Value="Bottom">
                                <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="1"/>
                                <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="Auto"/>
                                <Setter Property="Margin" TargetName="HeaderPanel" Value="2,0,2,2"/>
                            </Trigger>

                            <Trigger Property="TabStripPlacement" Value="Left">
                                <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="ContentPanel" Value="1"/>
                                <Setter Property="Width" TargetName="ColumnDefinition0" Value="Auto"/>
                                <Setter Property="Width" TargetName="ColumnDefinition1" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                <Setter Property="Margin" TargetName="HeaderPanel" Value="2,2,0,2"/>
                            </Trigger>

                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter Property="Grid.Row" TargetName="HeaderPanel" Value="0"/>
                                <Setter Property="Grid.Row" TargetName="ContentPanel" Value="0"/>
                                <Setter Property="Grid.Column" TargetName="HeaderPanel" Value="1"/>
                                <Setter Property="Grid.Column" TargetName="ContentPanel" Value="0"/>
                                <Setter Property="Width" TargetName="ColumnDefinition0" Value="*"/>
                                <Setter Property="Width" TargetName="ColumnDefinition1" Value="Auto"/>
                                <Setter Property="Height" TargetName="RowDefinition0" Value="*"/>
                                <Setter Property="Height" TargetName="RowDefinition1" Value="0"/>
                                <Setter Property="Margin" TargetName="HeaderPanel" Value="0,2,2,2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    Property="TextElement.Foreground"
                                    TargetName="templateRoot"
                                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self},Path=Items.Count}" Value="0">
                    <Setter Property="BorderThickness" Value="0" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabControl">
                                <!-- Start page: centered column, quick actions, recent files and guidelines on cards -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel
                                        Width="720"
                                        Margin="24,48,24,32"
                                        HorizontalAlignment="Center"
                                        TextElement.Foreground="{DynamicResource Ui.Text}">
                                        <StackPanel.Resources>
                                            <Style x:Key="StartCard" TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Ui.Card}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Ui.CardStroke}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="10" />
                                                <Setter Property="Padding" Value="20,14,20,16" />
                                                <Setter Property="Margin" Value="0,0,0,12" />
                                            </Style>

                                            <!-- Big quick-action tile -->
                                            <Style x:Key="StartAction" TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border
                                                                x:Name="Bd"
                                                                Background="{DynamicResource Ui.Card}"
                                                                BorderBrush="{DynamicResource Ui.CardStroke}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="18,16">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <!-- Recent file row -->
                                            <Style x:Key="RecentRow" TargetType="Button">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>

                                            <Style x:Key="StartGlyph" TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </StackPanel.Resources>

                                        <TextBlock Text="SIQuester" FontSize="30" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Static lp:Resources.StartSubtitle}" FontSize="15" Margin="0,2,0,22" Foreground="{DynamicResource Ui.Muted}" />

                                        <!-- Quick actions -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <Button Style="{StaticResource StartAction}" Command="ApplicationCommands.New">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Ui.Accent}" Margin="0,0,14,0">
                                                        <TextBlock Style="{StaticResource StartGlyph}" Text="&#xE8A5;" FontSize="18" Foreground="White" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Static lp:Resources.StartNew}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Static lp:Resources.StartNewHint}" FontSize="13" Foreground="{DynamicResource Ui.Muted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>

                                            <Button Grid.Column="2" Style="{StaticResource StartAction}" Command="ApplicationCommands.Open">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Ui.AccentSoft}" Margin="0,0,14,0">
                                                        <TextBlock Style="{StaticResource StartGlyph}" Text="&#xE838;" FontSize="18" Foreground="{DynamicResource Ui.Accent}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Static lp:Resources.StartOpen}" FontSize="16" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Static lp:Resources.StartOpenHint}" FontSize="13" Foreground="{DynamicResource Ui.Muted}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Recent files (hidden while the list is empty) -->
                                        <Border x:Name="recentCard" Style="{StaticResource StartCard}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Static lp:Resources.RecentFiles}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Accent}" Margin="0,0,0,6" />

                                                <ItemsControl ItemsSource="{Binding Settings.History.Files}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button
                                                                x:Name="open"
                                                                Style="{StaticResource RecentRow}"
                                                                Command="{Binding ElementName=main, Path=DataContext.OpenRecent}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding}">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StartGlyph}" Text="&#xE8A5;" FontSize="18" Foreground="{DynamicResource Ui.Glyph}" Margin="0,0,12,0" />

                                                                    <Button
                                                                        x:Name="remove"
                                                                        Visibility="Hidden"
                                                                        DockPanel.Dock="Right"
                                                                        Style="{StaticResource RecentRow}"
                                                                        Command="{Binding ElementName=main, Path=DataContext.RemoveRecent}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="{x:Static lp:Resources.RemoveLink}"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock Style="{StaticResource StartGlyph}" Text="&#xE711;" FontSize="11" Foreground="{DynamicResource Ui.Glyph}" />
                                                                    </Button>

                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Mode=OneWay, Converter={StaticResource FileNameConverter}}" FontSize="15" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Text}" />
                                                                        <TextBlock Text="{Binding Mode=OneWay, Converter={StaticResource DirectoryConverter}}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Muted}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Button>

                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="open" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="remove" Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Guidelines -->
                                        <Border Style="{StaticResource StartCard}" Padding="16,8,16,10">
                                            <Expander Foreground="{DynamicResource Ui.Text}" Background="Transparent" BorderThickness="0">
                                                <Expander.Header>
                                                    <TextBlock Text="{x:Static lp:Resources.ContentGuidelineHeader}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Accent}" />
                                                </Expander.Header>

                                                <TextBlock Text="{x:Static lp:Resources.ContentGuideline}" TextWrapping="Wrap" FontSize="14" Margin="4,8,4,4" Foreground="{DynamicResource Ui.Text}" />
                                            </Expander>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Settings.History.Files.Count}" Value="0">
                                        <Setter TargetName="recentCard" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCommandsItemStyle" TargetType="metro:WindowCommandsItem">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Gesture="CTRL+N" Command="ApplicationCommands.New" />
        <KeyBinding Gesture="CTRL+S" Command="{Binding ActiveDocument.Save}" />
        <KeyBinding Gesture="SHIFT+CTRL+S" Command="{Binding SaveAll}" />
        <KeyBinding Gesture="CTRL+Z" Command="{Binding ActiveDocument.OperationsManager.Undo}" />
        <KeyBinding Gesture="CTRL+Y" Command="{Binding ActiveDocument.OperationsManager.Redo}" />
        <KeyBinding Gesture="CTRL+X" Command="ApplicationCommands.Cut" />
        <KeyBinding Gesture="CTRL+C" Command="ApplicationCommands.Copy" />
        <KeyBinding Gesture="CTRL+V" Command="ApplicationCommands.Paste" />
        <KeyBinding Key="Delete" Command="{Binding ActiveDocument.Delete}" />
    </Window.InputBindings>
    
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="{x:Static lp:Resources.AppTitle}" />
    </Window.TaskbarItemInfo>

    <!--
        With the Fluent theme enabled WPF assigns its own Window style to every window whose Style is null.
        That style replaces the MahApps template and MetroWindow.OnApplyTemplate crashes (no PART_FlyoutModal).
        An explicit (empty) style prevents this; the MahApps template still comes from its default theme style.
    -->
    <metro:MetroWindow.Style>
        <Style TargetType="metro:MetroWindow" />
    </metro:MetroWindow.Style>

    <metro:MetroWindow.IconTemplate>
        <DataTemplate>
            <Grid
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                Margin="4"
                Background="Transparent"
                RenderOptions.EdgeMode="Aliased"
                RenderOptions.BitmapScalingMode="HighQuality">
                <Image Source="Resources/logo.jpg" />
            </Grid>
        </DataTemplate>
    </metro:MetroWindow.IconTemplate>
    
    <metro:MetroWindow.WindowButtonCommands>
        <metro:WindowButtonCommands
            LightMaxButtonStyle="{StaticResource TitleButton}"
            LightMinButtonStyle="{StaticResource TitleButton}"
            LightCloseButtonStyle="{StaticResource TitleButton}" />
    </metro:MetroWindow.WindowButtonCommands>
    
    <metro:MetroWindow.LeftWindowCommands>
        <metro:WindowCommands ShowSeparators="False" ShowLastSeparator="False">

            <Button Style="{StaticResource TitleBarButton}" ToolTip="{x:Static lp:Resources.ToolTipNew}" Command="ApplicationCommands.New">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE8A5;" />
            </Button>

            <Button Style="{StaticResource TitleBarButton}" ToolTip="{x:Static lp:Resources.Open}" Command="ApplicationCommands.Open">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE838;" />
            </Button>

            <siq:DropDownButton
                Style="{StaticResource TitleBarButton}"
                Width="20"
                ToolTip="{x:Static lp:Resources.OpenRecent}"
                DataContext="{Binding}"
                IsEnabled="{Binding Settings.History.Files.Count,Converter={StaticResource GreaterZero}}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE70D;" FontSize="10" />

                <siq:DropDownButton.DropDown>
                    <ContextMenu ItemsSource="{Binding Settings.History.Files}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="HeaderedItemsControl.Header" Value="{Binding}" />
                                <Setter Property="MenuItem.Command" Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=DataContext.OpenRecent}" />
                                <Setter Property="MenuItem.CommandParameter" Value="{Binding}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </siq:DropDownButton.DropDown>
            </siq:DropDownButton>

            <siq:DropDownButton Style="{StaticResource TitleBarButton}" ToolTip="{x:Static lp:Resources.Import}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE8B5;" />
                
                <siq:DropDownButton.DropDown>
                    <ContextMenu>
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                            </Style>
                        </ContextMenu.ItemContainerStyle>

                        <MenuItem
                            Header="{x:Static lp:Resources.ImportText}"
                            ToolTip="{x:Static lp:Resources.ImportTextTip}"
                            Command="{Binding ImportTxt}">
                            <MenuItem.Icon>
                                <Path Stretch="Uniform" Fill="Gray" Margin="3,0,0,0" Data="{Binding Source={StaticResource app_text},Path=Data}" Height="20" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{x:Static lp:Resources.ImportXml}" Command="{Binding ImportXml}" />
                        <MenuItem Header="YAML…" Command="{Binding ImportYaml}" />

                        <MenuItem Header="{x:Static lp:Resources.ImportDB}" Command="{Binding ImportBase}" Height="30">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="4,0,0,0" Height="20" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentUICulture.Name, Source={x:Static st:Thread.CurrentThread}}" Value="en-US">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        
                        <MenuItem Header="{x:Static lp:Resources.ImportSIStorage}" Command="{Binding ImportFromSIStore}" />
                    </ContextMenu>
                </siq:DropDownButton.DropDown>
            </siq:DropDownButton>

            <Button Style="{StaticResource TitleBarButton}" ToolTip="{x:Static lp:Resources.SaveAll}" Command="{Binding SaveAll}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE78C;" />
            </Button>

            <Button
                Style="{StaticResource TitleBarButton}"
                ToolTip="{x:Static lp:Resources.ToolTipFileSearch}"
                Command="{Binding SearchFolder}">                
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE721;" />
            </Button>
        </metro:WindowCommands>
    </metro:MetroWindow.LeftWindowCommands>
    
    <metro:MetroWindow.RightWindowCommands>
        <metro:WindowCommands ShowSeparators="False" ShowLastSeparator="False">
            <Button
                Style="{StaticResource TitleBarButton}"
                ToolTip="{x:Static lp:Resources.ToggleTheme}"
                Command="{Binding ToggleTheme}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE706;" />
            </Button>

            <Button
                Style="{StaticResource TitleBarButton}"
                ToolTip="{x:Static lp:Resources.Settings}"
                Command="{Binding SetSettings}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE713;" />
            </Button>

            <siq:DropDownButton Style="{StaticResource TitleBarButton}" ToolTip="{x:Static lp:Resources.Help}">
                <TextBlock Style="{StaticResource TitleBarGlyph}" Text="&#xE897;" />
                
                <siq:DropDownButton.DropDown>
                    <ContextMenu>
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                            </Style>
                        </ContextMenu.ItemContainerStyle>

                        <MenuItem
                            Header="{x:Static lp:Resources.ContactAuthor}"
                            ToolTip="{x:Static lp:Resources.ContactAuthorToolTip}"
                            Command="{Binding Feedback}" />

                        <MenuItem Header="{x:Static lp:Resources.Donate}" Command="{Binding Donate}" />
                        <MenuItem Header="{x:Static lp:Resources.HowToUse}" Command="ApplicationCommands.Help" />
                        <MenuItem Header="{x:Static lp:Resources.About}" Command="{Binding About}" />
                    </ContextMenu>
                </siq:DropDownButton.DropDown>
            </siq:DropDownButton>
        </metro:WindowCommands>
    </metro:MetroWindow.RightWindowCommands>
    
    <!-- A panel as the window content: the theme change lays a snapshot of the old look over it (App.UpdateThemeSmoothly) -->
    <Grid>
        <TabControl
            Name="tabControl1" 
            SelectionChanged="TabControl1_SelectionChanged"
            Style="{StaticResource TabControlStyle1}"
            ItemContainerStyle="{StaticResource TabItemStyle1}" />
    </Grid>
</metro:MetroWindow>
