<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SImulator</RootNamespace>
    <AssemblyName>SImulator</AssemblyName>
    <AssemblyTitle>SImulator</AssemblyTitle>
    <Product>SImulator</Product>
    <Description>SIGame emulator for macOS</Description>
    <Version>$(SImulatorVersion)</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>ru-RU</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.9" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SImulator.ViewModel\SImulator.ViewModel.csproj" />
  </ItemGroup>

  <!-- Platform-independent parts shared with the Windows (WPF) version -->
  <ItemGroup>
    <Compile Include="..\SImulator\Implementation\FilePackageSource.cs" Link="Shared\FilePackageSource.cs" />
    <Compile Include="..\SImulator\Implementation\GameLogger.cs" Link="Shared\GameLogger.cs" />
    <Compile Include="..\SImulator\Implementation\RemoteBoard\RemoteBoardServer.cs" Link="Shared\RemoteBoardServer.cs" />
    <Compile Include="..\SImulator\Implementation\RemoteBoard\RemoteBoardHost.cs" Link="Shared\RemoteBoardHost.cs" />
    <Compile Include="..\SImulator\Implementation\BrowserDisplayDescriptor.cs" Link="Shared\BrowserDisplayDescriptor.cs" />
    <Compile Include="..\SImulator\Implementation\ButtonManagers\WebNew\*.cs" Link="Shared\WebNew\%(Filename)%(Extension)" />
    <Compile Include="..\SImulator\Properties\Resources.Designer.cs" Link="Properties\Resources.Designer.cs" />
    <EmbeddedResource Include="..\SImulator\Properties\Resources.resx" Link="Properties\Resources.resx" />
    <EmbeddedResource Include="..\SImulator\Properties\Resources.ru-RU.resx" Link="Properties\Resources.ru-RU.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\MacResources.resx" StronglyTypedLanguage="C#" StronglyTypedNamespace="SImulator.Properties" StronglyTypedClassName="MacResources" PublicClass="true" StronglyTypedFileName="$(IntermediateOutputPath)MacResources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SImulator\webtable\**" Link="webtable\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SImulator\wwwroot2\**" Link="wwwroot2\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SImulator\sounds\**" Link="sounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
