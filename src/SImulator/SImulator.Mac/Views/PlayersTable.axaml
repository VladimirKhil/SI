<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="clr-namespace:SImulator.Properties"
    xmlns:v="clr-namespace:SImulator.Views"
    xmlns:m="clr-namespace:SImulator.ViewModel.Model;assembly=SImulator.ViewModel"
    x:Class="SImulator.Views.PlayersTable">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
            <Button Content="+" Width="32" ToolTip.Tip="{x:Static p:Resources.AddPlayer}" Command="{Binding AddPlayer}" />
            <Button Content="✕" Width="32" ToolTip.Tip="{x:Static p:Resources.RemovePlayer}" Command="{Binding ClearPlayers}" />
            <Button Content="⟲" Width="32" ToolTip.Tip="{x:Static p:Resources.ResetSums}" Command="{Binding ResetSums}" />

            <TextBlock Text="{x:Static p:Resources.Price}" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox Text="{Binding Price}" IsEnabled="{Binding IsCommonPrice}" Width="80" VerticalAlignment="Center" />

            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" Text="{Binding DecisionMode, Converter={x:Static v:PlayersTable.DecisionHint}}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="32,2*,90,32,32,80,90,2*,32" Margin="0,0,0,2">
            <TextBlock Grid.Column="1" Text="{x:Static p:Resources.Name}" Foreground="Gray" />
            <TextBlock Grid.Column="2" Text="{x:Static p:Resources.Sum}" Foreground="Gray" />
            <TextBlock Grid.Column="5" Text="{x:Static p:Resources.RightAnswers}" Foreground="Gray" />
            <TextBlock Grid.Column="6" Text="{x:Static p:Resources.WrongAnswers}" Foreground="Gray" />
            <TextBlock Grid.Column="7" Text="{x:Static p:Resources.Answer}" Foreground="Gray" />
        </Grid>

        <ScrollViewer>
            <ItemsControl x:Name="players" ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="m:PlayerInfo">
                        <Grid ColumnDefinitions="32,2*,90,32,32,80,90,2*,32" Margin="0,1">
                            <Button
                                Content="●"
                                ToolTip.Tip="{x:Static p:Resources.GiveTurn}"
                                Command="{Binding #players.DataContext.GiveTurn}"
                                CommandParameter="{Binding}" />
                            <TextBox Grid.Column="1" Text="{Binding Name}" Margin="2,0" />
                            <TextBox Grid.Column="2" Text="{Binding Sum}" Margin="2,0" />
                            <Button
                                Grid.Column="3"
                                Content="−"
                                ToolTip.Tip="{x:Static p:MacResources.WrongAnswer}"
                                Command="{Binding #players.DataContext.SubtractStake}"
                                CommandParameter="{Binding}" />
                            <Button
                                Grid.Column="4"
                                Content="+"
                                ToolTip.Tip="{x:Static p:MacResources.RightAnswer}"
                                Command="{Binding #players.DataContext.AddStake}"
                                CommandParameter="{Binding}" />
                            <TextBlock Grid.Column="5" Text="{Binding Right}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="{Binding Wrong}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="{Binding Answer}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="8"
                                Content="✕"
                                ToolTip.Tip="{x:Static p:Resources.RemovePlayer}"
                                Command="{Binding #players.DataContext.RemovePlayer}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
